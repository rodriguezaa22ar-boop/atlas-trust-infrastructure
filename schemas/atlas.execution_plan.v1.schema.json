{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/atlas.execution_plan.v1.schema.json",
  "title": "Atlas Execution Plan v1 Candidate",
  "description": "AL-002 safety-hardened candidate structural contract. Validation does not grant authority or imply compiler, runtime, adapter, approval, or execution support.",
  "type": "object",
  "required": [
    "schema_version",
    "contract_status",
    "language_version",
    "execution_status",
    "compiler",
    "source",
    "contracts",
    "workflow",
    "expected_evidence",
    "privacy",
    "known_limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "atlas.execution_plan.v1"
    },
    "contract_status": {
      "const": "candidate"
    },
    "language_version": {
      "const": "atlas/0.1"
    },
    "execution_status": {
      "const": "not_implemented"
    },
    "compiler": {
      "$ref": "#/$defs/compiler"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "contracts": {
      "$ref": "#/$defs/contracts"
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "expected_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "policy_decision",
          "approval_binding",
          "adapter_identity",
          "input_digest",
          "output_digest",
          "model_reference",
          "run_outcome"
        ]
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "metadata_only",
        "raw_goal_embedded",
        "raw_prompt_embedded",
        "raw_model_output_embedded",
        "secrets_embedded",
        "environment_values_embedded",
        "authority_grants_embedded",
        "approval_decisions_embedded",
        "runtime_values_embedded"
      ],
      "additionalProperties": false,
      "properties": {
        "metadata_only": {
          "const": true
        },
        "raw_goal_embedded": {
          "const": false
        },
        "raw_prompt_embedded": {
          "const": false
        },
        "raw_model_output_embedded": {
          "const": false
        },
        "secrets_embedded": {
          "const": false
        },
        "environment_values_embedded": {
          "const": false
        },
        "authority_grants_embedded": {
          "const": false
        },
        "approval_decisions_embedded": {
          "const": false
        },
        "runtime_values_embedded": {
          "const": false
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "logicalReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
      "not": {
        "pattern": "^(secret|token|credential|password|api[_-]?key|sk[-_]|gh[pousr]_|github_pat_|AKIA|ASIA)([A-Za-z0-9._-]*)$"
      }
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "workspacePath": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^\\./[A-Za-z0-9._/-]+$",
      "allOf": [
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        {
          "not": {
            "pattern": "^\\./(tmp|\\.tmp|var/tmp)(/|$)"
          }
        }
      ]
    },
    "compiler": {
      "type": "object",
      "required": [
        "name",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "atlas-lang"
        },
        "status": {
          "const": "not_implemented"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "reference",
        "entrypoint",
        "digest_status"
      ],
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/workspacePath"
        },
        "entrypoint": {
          "$ref": "#/$defs/identifier"
        },
        "digest_status": {
          "enum": [
            "deferred",
            "recorded"
          ]
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "digest_status": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "required": [
              "digest"
            ]
          }
        }
      ]
    },
    "contractReference": {
      "type": "object",
      "required": [
        "reference",
        "digest_status"
      ],
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/repositoryPath"
        },
        "digest_status": {
          "enum": [
            "deferred",
            "recorded"
          ]
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "digest_status": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "required": [
              "digest"
            ]
          }
        }
      ]
    },
    "policyContract": {
      "type": "object",
      "required": [
        "policy_ref",
        "runtime_evaluator",
        "evaluator_ref",
        "rego_contract_ref",
        "digest_status"
      ],
      "additionalProperties": false,
      "properties": {
        "policy_ref": {
          "$ref": "#/$defs/logicalReference"
        },
        "runtime_evaluator": {
          "const": "shell-jq"
        },
        "evaluator_ref": {
          "$ref": "#/$defs/repositoryPath"
        },
        "rego_contract_ref": {
          "$ref": "#/$defs/repositoryPath"
        },
        "digest_status": {
          "enum": [
            "deferred",
            "recorded"
          ]
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "digest_status": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "required": [
              "digest"
            ]
          }
        }
      ]
    },
    "projectConfiguration": {
      "type": "object",
      "required": [
        "status",
        "digest_status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_supplied",
            "checked_in"
          ]
        },
        "reference": {
          "$ref": "#/$defs/workspacePath"
        },
        "digest_status": {
          "enum": [
            "deferred",
            "recorded"
          ]
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "checked_in"
              }
            }
          },
          "then": {
            "required": [
              "reference",
              "digest"
            ],
            "properties": {
              "digest_status": {
                "const": "recorded"
              }
            }
          }
        }
      ]
    },
    "contracts": {
      "type": "object",
      "required": [
        "capability_manifest",
        "adapter_registry",
        "policy",
        "project_configuration"
      ],
      "additionalProperties": false,
      "properties": {
        "capability_manifest": {
          "$ref": "#/$defs/contractReference"
        },
        "adapter_registry": {
          "$ref": "#/$defs/contractReference"
        },
        "policy": {
          "$ref": "#/$defs/policyContract"
        },
        "project_configuration": {
          "$ref": "#/$defs/projectConfiguration"
        }
      }
    },
    "providerBinding": {
      "type": "object",
      "required": [
        "reference",
        "binding_status"
      ],
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/logicalReference"
        },
        "binding_status": {
          "const": "unresolved"
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "required": [
        "kind",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "artifact"
        },
        "path": {
          "$ref": "#/$defs/workspacePath"
        }
      }
    },
    "instructionReference": {
      "type": "object",
      "required": [
        "source_field",
        "raw_text_embedded"
      ],
      "additionalProperties": false,
      "properties": {
        "source_field": {
          "const": "goal"
        },
        "raw_text_embedded": {
          "const": false
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "timeout_seconds",
        "maximum_attempts",
        "maximum_tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "maximum_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "agent",
        "provider",
        "requested_capabilities",
        "policy_ref",
        "approval_mode",
        "inputs",
        "outputs",
        "instruction",
        "limits",
        "receipt_required"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "agent": {
          "$ref": "#/$defs/identifier"
        },
        "provider": {
          "$ref": "#/$defs/providerBinding"
        },
        "requested_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/logicalReference"
          }
        },
        "policy_ref": {
          "$ref": "#/$defs/logicalReference"
        },
        "approval_mode": {
          "const": "policy"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactReference"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactReference"
          }
        },
        "instruction": {
          "$ref": "#/$defs/instructionReference"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "receipt_required": {
          "const": true
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "execution_order",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "main"
        },
        "execution_order": {
          "const": "sequential"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    }
  }
}
